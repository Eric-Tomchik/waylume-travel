NEXT_PUBLIC_CONVEX_URL=https://secret-heron-979.convex.cloud
CONVEX_SITE_URL=https://secret-heron-979.convex.site
# Set this to a long random secret in BOTH the web host and Convex deployment environments.
WAYLUME_ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional outbound notification delivery webhook. When unset, messages remain safely queued in Waylume.
WAYLUME_NOTIFICATION_WEBHOOK_URL=
WAYLUME_NOTIFICATION_WEBHOOK_SECRET=

# Optional AI itinerary-draft provider webhook. When unset, Waylume uses its built-in deterministic draft builder.
WAYLUME_ITINERARY_DRAFT_WEBHOOK_URL=
WAYLUME_ITINERARY_DRAFT_WEBHOOK_SECRET=
